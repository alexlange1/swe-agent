# All credentials are optional. With none set, Alpha runs on the demo provider.

# On-chain / market data
TAOSTATS_API_KEY=
SUBTENSOR_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443

# Development signal
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

# Social / awareness
X_BEARER_TOKEN=
DISCORD_BOT_TOKEN=

# AI layer (Oracle + feed summaries)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
ORACLE_MODEL=anthropic/claude-3.5-sonnet

# Telegram alerts (optional) — set both to enable push delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Behaviour
SCAN_INTERVAL_MINUTES=15
SCAN_ON_STARTUP=true
SUBNET_COUNT=128
CORS_ORIGINS=*
